{
  "name": "textured",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "test:quota": "node scripts/test-quota.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "test:semantic": "node scripts/test-semantic.mjs",
    "test:share": "node scripts/test-share.mjs",
    "test:embed": "node scripts/test-embed.mjs",
    "test:instrument": "node scripts/test-instrument.mjs",
    "test:dsp": "node scripts/test-dsp.mjs",
    "test": "npm run test:semantic && npm run test:share && npm run test:embed && npm run test:instrument && npm run test:quota && npm run test:dsp",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:setup": "wrangler d1 execute DB --local --config dist/server/wrangler.json --persist-to .wrangler/state --file drizzle/0000_daily_allowances.sql"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.134.0",
    "jsdom": "26.1.0",
    "miniflare": "4.20260730.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "license": "MIT"
}
